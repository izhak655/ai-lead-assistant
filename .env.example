# Copy to .env for local development. Docker Compose supplies these itself.
# Never commit real API keys.

# mysql://USER:PASSWORD@HOST:3306/DATABASE
DATABASE_URL=mysql://lead:lead@127.0.0.1:3306/lead_assistant

# Tests refuse to run unless the database name contains lead_assistant_test.
# The Compose MySQL init script creates this database.
TEST_DATABASE_URL=mysql://lead:lead@127.0.0.1:3306/lead_assistant_test

REDIS_URL=redis://127.0.0.1:6379

# mock: deterministic tool calls, no API key required
# openai: live tool calling (falls back to mock if the request fails before any write)
AI_MODE=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

PORT=4000
WEB_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# inline: process jobs in the API process (used by tests)
# bullmq: Redis-backed queue (used by Docker Compose)
QUEUE_DRIVER=bullmq

# How long to wait before a qualifying lead with no reply gets one follow-up.
FOLLOW_UP_DELAY_MS=86400000

APP_TIMEZONE=Asia/Jerusalem

# Browser bundle target for the dashboard. Required at `next build` / `next dev`.
NEXT_PUBLIC_API_URL=http://localhost:4000
